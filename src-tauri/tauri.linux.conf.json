{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GChat",
        "width": 1200,
        "minWidth": 1024,
        "height": 800,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true,
        "center": true,
        "hiddenTitle": true,
        "transparent": false,
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "decorations": true,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": [
            "fullScreenUI",
            "mica",
            "tabbed",
            "blur",
            "acrylic"
          ],
          "state": "active"
        },
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "resources": [
      "resources/pre-install/**/*",
      "resources/LICENSE",
      "resources/agent-skills/**/*",
      "resources/bin/gchat-cli",
      "resources/bin/ginfer-host",
      "resources/bin/launch-profiles.json",
      "resources/bin/sqlite-vec.so",
      "resources/bin/bun",
      "resources/bin/uv",
      "resources/ginfer/linux/**/*",
      "resources/ginfer/docs/**/*"
    ],
    "externalBin": [],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "depends": [
          "libc6 (>= 2.39)",
          "libstdc++6",
          "libgcc-s1",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libxdo3",
          "libssl3t64",
          "libcurl4t64",
          "ca-certificates",
          "libdav1d7",
          "zlib1g"
        ],
        "recommends": [
          "gnome-keyring"
        ]
      }
    }
  }
}
