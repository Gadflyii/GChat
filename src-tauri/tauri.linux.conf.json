{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GChat",
        "width": 1200,
        "minWidth": 1024,
        "height": 800,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true,
        "center": true,
        "hiddenTitle": true,
        "transparent": false,
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "decorations": true,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": ["fullScreenUI", "mica", "tabbed", "blur", "acrylic"],
          "state": "active"
        },
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["appimage"],
    "resources": [
      "resources/pre-install/**/*",
      "resources/LICENSE",
      "resources/agent-skills/**/*",
      "resources/bin/gchat-cli",
      "resources/bin/sqlite-vec.so"
    ],
    "externalBin": ["resources/bin/uv"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      }
    }
  }
}
